              }
            }
          ]
        },
        "expect": true
      },
      {
        "name": "Freitext und timing",
        "dosage": {
          "text": "x",
          "timing": {
            "repeat": {
              "when": [
                "MORN"
              ]
            }
          }
        },
        "expect": false
      },
      {
        "name": "Freitext und doseAndRate",
        "dosage": {
          "text": "x",
          "doseAndRate": [
            {
              "doseQuantity": {
