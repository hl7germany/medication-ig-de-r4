[
  {
    "invariant": "RenderedRequiresMeta-MR",
    "context": "Resource",
    "resourceTypes": [
      "MedicationRequest"
    ],
    "cases": [
      {
        "name": "renderedDosageInstruction mit GeneratedDosageInstructionsMeta",
        "extension": [
          {
            "url": "http://hl7.org/fhir/5.0/StructureDefinition/extension-{{resourceType}}.renderedDosageInstruction",
            "valueMarkdown": "morgens: 1 Stück"
          },
          {
            "url": "http://ig.fhir.de/igs/medication/StructureDefinition/GeneratedDosageInstructionsMeta",
            "extension": [
              {
                "url": "algorithmVersion",
                "valueString": "x"
              },
              {
                "url": "language",
                "valueCode": "de-DE"
              }
            ]
          }
        ],
        "expect": true
      },
      {
        "name": "beide Extensions mit Dosierung",
        "dosage": {
          "timing": {
            "repeat": {
              "when": [
                "MORN"
              ]
            }
          },
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück",
                "system": "https://fhir.kbv.de/CodeSystem/KBV_CS_SFHIR_BMP_DOSIEREINHEIT",
                "code": "1"
              }
            }
          ]
        },
        "extension": [
          {
            "url": "http://hl7.org/fhir/5.0/StructureDefinition/extension-{{resourceType}}.renderedDosageInstruction",
            "valueMarkdown": "morgens: 1 Stück"
          },
          {
            "url": "http://ig.fhir.de/igs/medication/StructureDefinition/GeneratedDosageInstructionsMeta",
            "extension": [
              {
                "url": "algorithmVersion",
                "valueString": "x"
              },
              {
                "url": "language",
                "valueCode": "de-DE"
              }
            ]
          }
        ],
        "expect": true
      },
      {
        "name": "nur renderedDosageInstruction ohne GeneratedDosageInstructionsMeta",
        "extension": [
          {
            "url": "http://hl7.org/fhir/5.0/StructureDefinition/extension-{{resourceType}}.renderedDosageInstruction",
            "valueMarkdown": "morgens: 1 Stück"
          }
        ],
        "expect": false
      },
      {
        "name": "nur GeneratedDosageInstructionsMeta ohne renderedDosageInstruction",
        "extension": [
          {
            "url": "http://ig.fhir.de/igs/medication/StructureDefinition/GeneratedDosageInstructionsMeta",
            "extension": [
              {
                "url": "algorithmVersion",
                "valueString": "x"
              },
              {
                "url": "language",
                "valueCode": "de-DE"
              }
            ]
          }
        ],
        "expect": true
      },
      {
        "name": "weder renderedDosageInstruction noch GeneratedDosageInstructionsMeta",
        "expect": true
      },
      {
        "name": "renderedDosageInstruction von MedicationStatement",
        "extension": [
          {
            "url": "http://hl7.org/fhir/5.0/StructureDefinition/extension-MedicationStatement.renderedDosageInstruction",
            "valueMarkdown": "morgens: 1 Stück"
          }
        ],
        "expect": true
      }
    ]
  },
