          "extension": [
            {
              "url": "http://hl7.org/fhir/5.0/StructureDefinition/extension-Dosage.asNeededFor",
              "valueCodeableConcept": {
                "text": "Kopfschmerzen"
              }
            }
          ],
          "text": "x"
        },
        "expect": true
      },
      {
        "name": "zwei Anlässe, asNeeded fehlt",
        "dosage": {
          "extension": [
            {
              "url": "http://hl7.org/fhir/5.0/StructureDefinition/extension-Dosage.asNeededFor",
              "valueCodeableConcept": {
                "text": "A"
              }
            },
            {
              "url": "http://hl7.org/fhir/5.0/StructureDefinition/extension-Dosage.asNeededFor",
              "valueCodeableConcept": {
                "text": "B"
              }
            }
          ],
          "text": "x"
        },
        "expect": true
      },
      {
        "name": "kein Anlass, asNeeded false",
        "dosage": {
          "asNeededBoolean": false,
          "text": "x"
        },
        "expect": true
      },
      {
        "name": "kein Anlass, asNeeded fehlt",
        "dosage": {
          "text": "x"
        },
        "expect": true
      },
      {
        "name": "fremde Extension",
        "dosage": {
          "extension": [
            {
              "url": "http://example.org/x",
              "valueString": "x"
            }
          ],
          "text": "x"
        },
        "expect": true
      }
